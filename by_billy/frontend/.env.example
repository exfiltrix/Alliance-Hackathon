# Copy to .env.local. Leave unset to run on demo data.
# Backend runs separately (no Docker): uvicorn app.main:app --port 8000
# Demo data is opt-in: set NEXT_PUBLIC_USE_MOCK=1 explicitly. Without a backend URL and
# without this flag, API calls fail with a configuration error instead of silently using mocks.
NEXT_PUBLIC_USE_MOCK=0
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser). The gateway's own device
# token: mint one with `python -m scripts.create_demo_device` in backend/, then paste it here.
# /api/seal (a Next.js route handler) uses it to seal on the backend's behalf.
MEDSEAL_BACKEND_URL=http://localhost:8000/api
MEDSEAL_DEVICE_TOKEN=
# P1-04: starting a crash test / issuing a passport are admin actions. Same admin token as
# MEDSEAL_ADMIN_TOKEN on the backend (backend/CLAUDE.md). Used by
# src/app/api/crash-test/route.ts and src/app/api/passport/route.ts — never sent to the browser.
MEDSEAL_ADMIN_TOKEN=

# P1-01: HTTP Basic Auth in front of the gateway simulator (/seal page + its API routes —
# src/proxy.ts). Unset means those routes refuse every request with 503 (fail closed).
MEDSEAL_GATEWAY_USER=
MEDSEAL_GATEWAY_PASSWORD=

# Doctor cabinet (/inbox page + its API routes). Same MEDSEAL_GATEWAY_USER/PASSWORD Basic Auth
# gates the page (src/proxy.ts) — the inbox holds real medical images and must never be public.
# MEDSEAL_DOCTOR_TOKEN is the separate backend bearer token for /api/inbox*, /api/automation*
# (see backend/CLAUDE.md MEDSEAL_DOCTOR_TOKEN) — never sent to the browser.
MEDSEAL_DOCTOR_TOKEN=

# Client (hospital/clinic) cabinet (/client page + its API routes). Minted once with
# POST /api/clients (admin token) on the backend; paste the returned token here.
MEDSEAL_CLIENT_TOKEN=
