# Copy to backend/.env (gitignored). Secrets live ONLY there — never in code, logs or NEXT_PUBLIC_*.

# Required for POST /devices and /devices/{id}/revoke
MEDSEAL_ADMIN_TOKEN=change-me

# --- Blockchain anchoring (docs/BLOCKCHAIN.md). Leave empty to switch anchoring off. ---
# Offline demo: `cd contracts && npx hardhat node`, then `npx hardhat run scripts/deploy.js --network localhost`.
# The local node prints its test accounts; use account #0's private key (a public, well-known
# Hardhat test key — never use it on a real network).
# Sepolia: RPC from Alchemy/Infura, a key of a wallet holding test ETH, EXPLORER_URL=https://sepolia.etherscan.io
RPC_URL=
ANCHOR_PRIVATE_KEY=
CONTRACT_ADDRESS=
CHAIN_ID=
EXPLORER_URL=
# ETHERSCAN_API_KEY=            # only for `npx hardhat verify`
# MEDSEAL_ANCHOR_INTERVAL=600   # seconds between batches (demo: POST /api/anchors/run)
# MEDSEAL_ANCHOR_CONFIRMATIONS=1
